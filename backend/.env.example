# ==============================================================================
# Chef AI Assistant - Environment Configuration Example
# Copy this file to .env and fill in your details
# ==============================================================================

# Security / JWT
SECRET_KEY=chef_ai_super_secret_jwt_key_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./chef_ai.db

# AI Provider Configuration (LangChain + Google Gemini via langchain-google-genai)
GOOGLE_API_KEY=your_google_api_key_here

# Optional: override the Gemini model used by the LangChain agent
GEMINI_MODEL=gemini-3.6-flash
